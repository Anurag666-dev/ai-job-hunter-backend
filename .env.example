# ==============================================================================
# Tech Job Hunters — Backend Environment Variables Configuration Template
# Copy this file to .env and replace the placeholder values with your credentials
# ==============================================================================

# Search Engine API (Brave Search API for jobs aggregation)
# Obtain a key at: https://brave.com/search/api/
BRAVE_API_KEY=your_brave_search_api_key_here
BRAVE_SEARCH_URL=https://api.search.brave.com/res/v1/web/search

# AI LLM Provider (OpenRouter API)
# Obtain a key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_TEXT_MODEL=openai/gpt-4o-mini

# PostgreSQL Database (Asyncpg driver)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tech_job_hunters

# Redis In-Memory Cache (Defaults to fast in-memory fallback if Redis is unavailable)
REDIS_URL=redis://localhost:6379

# JWT Authentication
SECRET_KEY=generate_a_random_32_character_secret_key_here
ACCESS_TOKEN_EXPIRE_HOURS=24

# Server Configuration
BACKEND_PORT=1776
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
